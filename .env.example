# Copy to .env — every value here works with `docker compose up` as-is.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- URLs ----------------------------------------------------------------------
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173
SITE_URL=http://localhost:4321

# --- Database ------------------------------------------------------------------
DATABASE_URL=postgres://teamflow:teamflow@localhost:5442/teamflow
TEST_DATABASE_URL=postgres://teamflow:teamflow@localhost:5442/teamflow_test

# --- Auth ----------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Object storage (RustFS locally, any S3-compatible service in production) --
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=teamflow-attachments
S3_ACCESS_KEY_ID=teamflow
S3_SECRET_ACCESS_KEY=teamflow-secret

# --- Mail (Mailpit locally) ----------------------------------------------------
SMTP_URL=smtp://localhost:1035
MAIL_FROM="TeamFlow <no-reply@teamflow.local>"
